diff --git a/src/components/cybiko_app/cybiko_browser.c b/src/components/cybiko_app/cybiko_browser.c
new file mode 100644
index 0000000..d7fbdf8
--- /dev/null
+++ b/src/components/cybiko_app/cybiko_browser.c
@@ -0,0 +1,134 @@
+/* The web browser in Cybiko mode (see cybiko_browser.h). */
+#include <string.h>
+#include <stdlib.h>
+#include <time.h>
+#include <sys/stat.h>
+#include "cybiko_browser.h"
+#include "cybiko_app.h"
+#include "cybiko_link.h"
+#include "cyb_net_esp.h"
+#include "m5_sd.h"
+#include "esp_log.h"
+#include "esp_heap_caps.h"
+#include "esp_timer.h"
+#include "freertos/FreeRTOS.h"
+#include "freertos/task.h"
+#include "freertos/semphr.h"
+
+static const char *TAG = "cy_browser";
+
+#define DATA_DIR CYBIKO_SD_DIR "/browser"   /* bookmarks and settings */
+#define APP_NAME "Browser.app"
+
+static cyb_t *browser;
+static volatile bool requested;
+
+void cybiko_browser_install(uint8_t *disk, uint32_t size)
+{
+    cy_disk_file_t f;
+    if (cy_disk_find(disk, size, APP_NAME, &f) && f.size == cyb_launcher_app_size) {
+        uint8_t *have = malloc(cyb_launcher_app_size);
+        bool same = have && cy_disk_read(disk, size, APP_NAME, have, (uint32_t)cyb_launcher_app_size) ==
+                                (int32_t)cyb_launcher_app_size &&
+                    !memcmp(have, cyb_launcher_app, cyb_launcher_app_size);
+        free(have);
+        if (same) return;
+    }
+    uint32_t date = (uint32_t)((int64_t)time(NULL) + 2208988800LL);   /* 1970 -> 1900 */
+    if (cy_disk_write(disk, size, APP_NAME, cyb_launcher_app, (uint32_t)cyb_launcher_app_size, date) == 0)
+        ESP_LOGI(TAG, "put %s on the RAM disk", APP_NAME);
+    else
+        ESP_LOGW(TAG, "no room for %s on the RAM disk", APP_NAME);
+}
+
+uint32_t cybiko_browser_app_call(void *user, uint32_t fn, uint32_t arg)
+{
+    (void)user;
+    (void)arg;
+    switch (fn) {
+    case CY_APP_VERSION: return CY_APP_API;
+    case CY_APP_BROWSER: requested = true; return 1;
+    default: return 0;
+    }
+}
+
+bool cybiko_browser_requested(void)
+{
+    bool r = requested;
+    requested = false;
+    return r;
+}
+
+static uint32_t now_ms(void) { return (uint32_t)(esp_timer_get_time() / 1000); }
+
+/* The browser runs in a task of its own: pages are parsed with a deeper stack
+ * than the CPU task has. Its stack may be in PSRAM (it never writes flash;
+ * the Wi-Fi networks are saved on the CPU task when it closes). */
+#define BROWSER_STACK 16384
+
+typedef struct {
+    cybiko_t *m;
+    bool (*next_key)(int *key, bool *down);
+    SemaphoreHandle_t done;
+} run_t;
+
+static void browser_task(void *arg)
+{
+    run_t *r = arg;
+    cybiko_t *m = r->m;
+    uint8_t *fb = malloc(CYB_FB_SIZE);
+    cyb_show(browser);
+    for (;;) {
+        int key;
+        bool down;
+        while (r->next_key(&key, &down)) {
+            int k = cybiko_browser_key(key);
+            if (k) cyb_key(browser, k, down);
+            /* releases reach CyOS's keyboard too, so none stays held down */
+            if (!down) cybiko_key(m, key, false);
+        }
+        if (!cyb_step(browser, now_ms())) break;
+        if (fb && cyb_render(browser, fb)) cybiko_lcd_show(m, fb);
+        vTaskDelay(pdMS_TO_TICKS(cyb_busy(browser) ? 5 : 20));
+    }
+    free(fb);
+    xSemaphoreGive(r->done);
+    vTaskSuspend(NULL);           /* deleted by the CPU task */
+}
+
+void cybiko_browser_run(cybiko_t *m, const uint8_t *flash, bool (*next_key)(int *key, bool *down))
+{
+    if (!browser) {
+        static cyb_net_t net;
+        cyb_net_esp(&net);
+        mkdir(DATA_DIR, 0777);
+        browser = cyb_create(&net, flash, CY_FLASH_SIZE, DATA_DIR);
+        if (!browser) { ESP_LOGE(TAG, "out of memory"); return; }
+    }
+    ESP_LOGI(TAG, "open; free PSRAM %u, internal %u", (unsigned)heap_caps_get_free_size(MALLOC_CAP_SPIRAM),
+             (unsigned)heap_caps_get_free_size(MALLOC_CAP_INTERNAL));
+    run_t r = { m, next_key, xSemaphoreCreateBinary() };
+    uint8_t *saved = malloc(sizeof m->lcd.ram);
+    TaskHandle_t task = NULL;
+    bool caps = false;
+    if (!r.done || !saved) goto out;
+    memcpy(saved, m->lcd.ram, sizeof m->lcd.ram);
+    if (xTaskCreatePinnedToCore(browser_task, "browser", BROWSER_STACK, &r, 4, &task, 1) != pdPASS) {
+        task = NULL;
+        caps = xTaskCreatePinnedToCoreWithCaps(browser_task, "browser", BROWSER_STACK, &r, 4, &task, 1,
+                                               MALLOC_CAP_SPIRAM | MALLOC_CAP_8BIT) == pdPASS;
+        if (!caps) task = NULL;
+    }
+    if (!task) { ESP_LOGE(TAG, "no memory for the browser task"); goto out; }
+    xSemaphoreTake(r.done, portMAX_DELAY);
+    if (caps) vTaskDeleteWithCaps(task);
+    else vTaskDelete(task);
+    memcpy(m->lcd.ram, saved, sizeof m->lcd.ram);
+    m->lcd.version++;
+out:
+    free(saved);
+    if (r.done) vSemaphoreDelete(r.done);
+    cyb_net_esp_stop();
+    cybiko_link_resume();
+    ESP_LOGI(TAG, "closed");
+}
diff --git a/src/components/cybiko_app/cybiko_gate.c b/src/components/cybiko_app/cybiko_gate.c
new file mode 100644
index 0000000..ff8ef5e
--- /dev/null
+++ b/src/components/cybiko_app/cybiko_gate.c
@@ -0,0 +1,119 @@
+/* The CyWIG on the board (see cybiko_gate.h). */
+#include <string.h>
+#include "cybiko_gate.h"
+#include "cybiko_link.h"
+#include "cy_gate.h"
+#include "cyb_net_esp.h"
+#include "palm_config.h"
+#include "esp_log.h"
+#include "esp_heap_caps.h"
+#include "esp_timer.h"
+#include "freertos/FreeRTOS.h"
+#include "freertos/queue.h"
+#include "freertos/task.h"
+
+static const char *TAG = "cywig";
+
+/* Pages are parsed on the gate's task: it needs the browser's deep stack.
+ * The stack may be in PSRAM (the gate never writes flash). */
+#define GATE_STACK 16384
+
+typedef struct {
+    uint8_t len, channel;
+    uint8_t data[CY_RF_LONG];
+} packet_t;
+
+static cy_gate_t *gate;
+static QueueHandle_t to_gate, to_machine;
+static volatile bool pause_req, paused;
+static char home[256];
+
+static uint32_t now_ms(void) { return (uint32_t)(esp_timer_get_time() / 1000); }
+
+static void gate_rf(void *user, const uint8_t *pkt, size_t len, uint8_t ch)
+{
+    (void)user;
+    packet_t p = { .len = (uint8_t)len, .channel = ch };
+    memcpy(p.data, pkt, len);
+    if (xQueueSend(to_machine, &p, pdMS_TO_TICKS(20)) != pdTRUE) ESP_LOGW(TAG, "packet for the Cybiko dropped");
+}
+
+static void gate_log(void *user, const char *line)
+{
+    (void)user;
+    ESP_LOGI(TAG, "%s", line);
+}
+
+static void gate_task(void *arg)
+{
+    uint32_t id = (uint32_t)(uintptr_t)arg;
+    static cyb_net_t net;
+    cyb_net_esp(&net);
+    cy_gate_host_t host = { .rf_send = gate_rf, .log = gate_log };
+    gate = cy_gate_create(id, &host, &net);
+    if (!gate) { ESP_LOGE(TAG, "out of memory"); vTaskDelete(NULL); return; }
+    if (home[0]) cy_gate_set_home(gate, home);
+    ESP_LOGI(TAG, "gate %08lx on the radio", (unsigned long)id);
+    uint32_t wait = 0;
+    for (;;) {
+        if (pause_req) {
+            cy_gate_cancel(gate);
+            paused = true;
+            while (pause_req) vTaskDelay(pdMS_TO_TICKS(20));
+            paused = false;
+        }
+        packet_t p;
+        if (xQueueReceive(to_gate, &p, pdMS_TO_TICKS(wait > 50 ? 50 : wait)) == pdTRUE) {
+            cy_gate_rf_in(gate, p.data, p.len, p.channel);
+            while (xQueueReceive(to_gate, &p, 0) == pdTRUE) cy_gate_rf_in(gate, p.data, p.len, p.channel);
+        }
+        wait = cy_gate_poll(gate, now_ms());
+        if (!wait) wait = 1;
+    }
+}
+
+void cybiko_gate_init(cybiko_t *m, const char *cfg)
+{
+    char value[16] = "on";
+    if (cfg) config_get_value(cfg, "wap.gate", value, sizeof value);
+    if (!strcmp(value, "off")) { ESP_LOGI(TAG, "no gate (wap.gate = off)"); return; }
+    if (cfg) config_get_value(cfg, "wap.home", home, sizeof home);
+    to_gate = xQueueCreate(8, sizeof(packet_t));
+    to_machine = xQueueCreate(8, sizeof(packet_t));
+    if (!to_gate || !to_machine) { ESP_LOGE(TAG, "out of memory"); return; }
+    /* an ID of its own: the machine's with another first byte */
+    uint32_t id = cybiko_unit_id(m) ^ 0x01000000u;
+    TaskHandle_t task;
+    if (xTaskCreatePinnedToCore(gate_task, "cywig", GATE_STACK, (void *)(uintptr_t)id, 3, &task, 0) != pdPASS &&
+        xTaskCreatePinnedToCoreWithCaps(gate_task, "cywig", GATE_STACK, (void *)(uintptr_t)id, 3, &task, 0,
+                                        MALLOC_CAP_SPIRAM | MALLOC_CAP_8BIT) != pdPASS)
+        ESP_LOGE(TAG, "no memory for the gate task");
+}
+
+void cybiko_gate_send(void *user, const uint8_t *pkt, size_t len, uint8_t channel)
+{
+    cybiko_link_send(user, pkt, len, channel);
+    if (!to_gate) return;
+    packet_t p = { .len = (uint8_t)len, .channel = channel };
+    memcpy(p.data, pkt, len);
+    xQueueSend(to_gate, &p, 0);
+}
+
+void cybiko_gate_poll(cybiko_t *m)
+{
+    if (!to_machine) return;
+    cyb_net_esp_save();     /* networks set on the gate's Wi-Fi page (needs this internal stack) */
+    packet_t p;
+    while (xQueuePeek(to_machine, &p, 0) == pdTRUE) {
+        if (!cybiko_rf_receive(m, p.data, p.len, p.channel)) break;    /* full: next time */
+        xQueueReceive(to_machine, &p, 0);
+    }
+}
+
+void cybiko_gate_pause(bool pause)
+{
+    if (!to_gate) return;
+    pause_req = pause;
+    if (!pause) return;
+    for (int i = 0; i < 100 && !paused && gate; i++) vTaskDelay(pdMS_TO_TICKS(10));
+}
